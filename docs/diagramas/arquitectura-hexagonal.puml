@startuml arquitectura-hexagonal
!theme plain
title EC2 Shell Desk - Arquitectura Hexagonal (Wails v2 + Go)

package "Frontend Desktop (WebView2)" {
  [Vanilla TypeScript + Vite + xterm.js] as UI
  [Wails Bindings & Events] as IPC
  UI --> IPC
}

package "Driving Adapters (internal/app)" {
  [AuthHandler]
  [HostHandler]
  [KeyHandler]
  [TerminalHandler]
  [SFTPHandler]
  [TunnelHandler]
  [SnippetHandler]
  [ObservabilityHandler]
}

package "Application Services (internal/services)" {
  [AuthService]
  [VaultService]
  [HostService]
  [SessionService]
  [TransferService]
  [TunnelService]
  [SnippetService]
  [ObservabilityService]
}

package "Core Hexagon (internal/core)" {
  package "ports" {
    interface UserRepository
    interface KeyRepository
    interface HostRepository
    interface HostGroupRepository
    interface TunnelRepository
    interface SnippetRepository
    interface ServiceRepository
    interface KeyEncryptor
    interface PasswordHasher
    interface SSHSessionManager
    interface SFTPClient
    interface LocalFileSystem
    interface HealthProber
  }
  package "domain" {
    [User]
    [SSHKey]
    [HostGroup]
    [HostInstance]
    [SSHTunnel]
    [CommandSnippet]
    [PrivateService]
    [FileEntry]
    [TransferTask]
  }
}

package "Driven Adapters (internal/adapters)" {
  [sqlite (modernc.org/sqlite)] as SQLite
  [crypto (Argon2id + AES-256-GCM)] as Crypto
  [sshclient (x/crypto/ssh + Pool)] as SSH
  [sftpclient (pkg/sftp)] as SFTP
  [winfs (Windows Disk)] as WinFS
  [httpprobe (net/http TLS 1.2+)] as HTTPProbe
}

IPC --> [AuthHandler]
IPC --> [HostHandler]
IPC --> [KeyHandler]
IPC --> [TerminalHandler]
IPC --> [SFTPHandler]
IPC --> [TunnelHandler]
IPC --> [SnippetHandler]
IPC --> [ObservabilityHandler]

[AuthHandler] --> [AuthService]
[HostHandler] --> [HostService]
[KeyHandler] --> [VaultService]
[TerminalHandler] --> [SessionService]
[SFTPHandler] --> [TransferService]
[TunnelHandler] --> [TunnelService]
[SnippetHandler] --> [SnippetService]
[ObservabilityHandler] --> [ObservabilityService]

[AuthService] --> UserRepository
[AuthService] --> PasswordHasher
[VaultService] --> KeyRepository
[VaultService] --> KeyEncryptor
[HostService] --> HostRepository
[HostService] --> HostGroupRepository
[SessionService] --> SSHSessionManager
[TransferService] --> SFTPClient
[TransferService] --> LocalFileSystem
[TunnelService] --> TunnelRepository
[TunnelService] --> SSHSessionManager
[SnippetService] --> SnippetRepository
[ObservabilityService] --> ServiceRepository
[ObservabilityService] --> SSHSessionManager
[ObservabilityService] --> HealthProber

SQLite ..|> UserRepository
SQLite ..|> KeyRepository
SQLite ..|> HostRepository
SQLite ..|> HostGroupRepository
SQLite ..|> TunnelRepository
SQLite ..|> SnippetRepository
SQLite ..|> ServiceRepository
Crypto ..|> KeyEncryptor
Crypto ..|> PasswordHasher
SSH ..|> SSHSessionManager
SFTP ..|> SFTPClient
WinFS ..|> LocalFileSystem
HTTPProbe ..|> HealthProber

@enduml
