# Binaries and build outputs
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
build/bin/
dist/

# Wails generated artifacts
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/wailsjs/
frontend/package.json.md5

# Local databases, vaults, and user secrets (NEVER commit)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pem
*.ppk
*.key
id_rsa*
id_ed25519*
known_hosts
!testdata/**

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Logs and temporary files
*.log
coverage.out
coverage.html
tmp/
